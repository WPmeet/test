# ============================================================
# POD LOGS
#
# 4 logs at a time.
# PIDs tracked explicitly.
# ============================================================

collect_logs() {

    echo "[LOGS] Starting..."

    if ! kubectl get pods \
        -n "$namespace" \
        --no-headers \
        -o custom-columns=":metadata.name" \
        > pod-list.txt \
        2> pod-list-error.txt; then

        echo "[LOGS] Failed to retrieve pod list"
        return 1
    fi

    EXPECTED=$(grep -cve '^[[:space:]]*$' pod-list.txt)

    echo "[LOGS] Pods discovered: $EXPECTED"

    pids=""
    batch_count=0
    batch_number=1

    while IFS= read -r pod; do

        [ -z "$pod" ] && continue

        kubectl logs "$pod" \
            -n "$namespace" \
            --all-containers=true \
            > "logs/${pod}.log" 2>&1 &

        pid=$!

        pids="$pids $pid"

        echo "[LOGS] $pod -> PID $pid"

        batch_count=$((batch_count + 1))

        if [ "$batch_count" -ge "$LOG_BATCH_SIZE" ]; then

            wait_for_pid_batch \
                "LOG-BATCH-$batch_number" \
                $pids || true

            pids=""
            batch_count=0
            batch_number=$((batch_number + 1))
        fi

    done < pod-list.txt

    if [ "$batch_count" -gt 0 ]; then

        wait_for_pid_batch \
            "LOG-BATCH-$batch_number" \
            $pids || true
    fi

    COLLECTED=$(find logs \
        -type f \
        -name "*.log" \
        | wc -l | tr -d ' ')

    echo "[LOGS] Expected=$EXPECTED Files=$COLLECTED"

    return 0
}


# ============================================================
# DISCOVER ALL CFK RESOURCE TYPES
# AND CAPTURE THEIR OBJECT COUNTS BEFORE COLLECTION
# ============================================================

prepare_cfk_lists() {

    echo
    echo "============================================================"
    echo " PRE-COLLECTION CFK INVENTORY"
    echo "============================================================"

    kubectl api-resources \
        --verbs=list \
        --namespaced=true \
        -o name \
        2> cfk-api-resources-error.txt \
        | grep "platform.confluent.io" \
        > cfk-resource-types.txt

    if [ ! -s cfk-resource-types.txt ]; then

        echo "[CFK] No platform.confluent.io resource types discovered"
        return 1
    fi

    TYPE_COUNT=$(grep -cve '^[[:space:]]*$' cfk-resource-types.txt)

    echo "[CFK] Resource types discovered: $TYPE_COUNT"
    echo

    TOTAL_EXPECTED=0

    while IFS= read -r resource_type; do

        [ -z "$resource_type" ] && continue

        safe_type=$(echo "$resource_type" | tr '/.' '__')

        list_file="cfk-lists/${safe_type}.txt"

        echo "[CFK] Listing: $resource_type"

        if ! kubectl get "$resource_type" \
            -n "$namespace" \
            --no-headers \
            -o custom-columns=":metadata.name" \
            > "$list_file" \
            2> "cfk-lists/${safe_type}-error.txt"; then

            echo "[CFK] ERROR listing $resource_type"
            return 1
        fi

        EXPECTED=$(grep -cve '^[[:space:]]*$' "$list_file")

        echo "[CFK] $resource_type -> EXPECTED=$EXPECTED"

        TOTAL_EXPECTED=$((TOTAL_EXPECTED + EXPECTED))

        {
            echo "ResourceType=$resource_type"
            echo "Expected=$EXPECTED"
        } > "cfk-summaries/${safe_type}-initial.txt"

    done < cfk-resource-types.txt

    echo
    echo "============================================================"
    echo " CFK TOTAL EXPECTED BEFORE COLLECTION: $TOTAL_EXPECTED"
    echo "============================================================"

    echo "$TOTAL_EXPECTED" > cfk-total-expected.txt

    return 0
}


# ============================================================
# COLLECT ONE CFK OBJECT
# ============================================================

collect_one_cfk_object() {

    resource_type="$1"
    object_name="$2"
    safe_type="$3"

    resource_dir="cfk-resources/${safe_type}"

    mkdir -p "$resource_dir"

    tmp_file="${resource_dir}/${object_name}.yaml.tmp"
    final_file="${resource_dir}/${object_name}.yaml"

    attempt=1

    while [ "$attempt" -le "$MAX_RETRIES" ]; do

        if kubectl get "$resource_type" "$object_name" \
            -n "$namespace" \
            -o yaml \
            > "$tmp_file" 2>&1; then

            if grep -q "^apiVersion:" "$tmp_file" && \
               grep -q "^kind:" "$tmp_file" && \
               grep -q "^metadata:" "$tmp_file"; then

                mv "$tmp_file" "$final_file"

                echo "[CFK][$resource_type] OK: $object_name"

                return 0
            fi
        fi

        rm -f "$tmp_file"

        echo "[CFK][$resource_type] Retry $attempt/$MAX_RETRIES: $object_name"

        attempt=$((attempt + 1))

        sleep 2

    done

    echo "$object_name" \
        >> "cfk-summaries/${safe_type}-failed.txt"

    echo "[CFK][$resource_type] FAILED: $object_name"

    return 1
}


# ============================================================
# COLLECT ONE CFK RESOURCE TYPE
#
# Example:
#
# KafkaTopics:
#   50 background jobs
#   track all 50 PIDs
#   wait until all finish
#   next 50
#
# Then:
#
# CFRBs:
#   50 background jobs
#   wait
#   next 50
#
# etc.
# ============================================================

collect_cfk_type() {

    resource_type="$1"

    safe_type=$(echo "$resource_type" | tr '/.' '__')

    list_file="cfk-lists/${safe_type}.txt"

    failed_file="cfk-summaries/${safe_type}-failed.txt"

    summary_file="cfk-summaries/${safe_type}-summary.txt"

    resource_dir="cfk-resources/${safe_type}"

    mkdir -p "$resource_dir"

    rm -f "$failed_file"

    EXPECTED=$(grep -cve '^[[:space:]]*$' "$list_file")

    echo
    echo "============================================================"
    echo " CFK RESOURCE TYPE"
    echo "============================================================"
    echo " Resource  : $resource_type"
    echo " Expected  : $EXPECTED"
    echo " Batch     : $CR_BATCH_SIZE"
    echo "============================================================"

    if [ "$EXPECTED" -eq 0 ]; then

        {
            echo "ResourceType=$resource_type"
            echo "Expected=0"
            echo "Collected=0"
            echo "Failed=0"
            echo "Status=OK"
        } > "$summary_file"

        return 0
    fi

    pids=""
    batch_count=0
    batch_number=1

    while IFS= read -r object_name; do

        [ -z "$object_name" ] && continue

        collect_one_cfk_object \
            "$resource_type" \
            "$object_name" \
            "$safe_type" &

        pid=$!

        pids="$pids $pid"

        echo "[CFK][$resource_type] $object_name -> PID $pid"

        batch_count=$((batch_count + 1))

        if [ "$batch_count" -ge "$CR_BATCH_SIZE" ]; then

            wait_for_pid_batch \
                "CFK-${safe_type}-BATCH-$batch_number" \
                $pids || true

            pids=""
            batch_count=0
            batch_number=$((batch_number + 1))
        fi

    done < "$list_file"

    if [ "$batch_count" -gt 0 ]; then

        wait_for_pid_batch \
            "CFK-${safe_type}-BATCH-$batch_number" \
            $pids || true
    fi


    # ========================================================
    # COUNT VALID SUCCESSFUL FILES
    # ========================================================

    COLLECTED=$(find "$resource_dir" \
        -type f \
        -name "*.yaml" \
        | wc -l \
        | tr -d ' ')

    FAILED=0

    if [ -f "$failed_file" ]; then

        FAILED=$(grep -cve '^[[:space:]]*$' "$failed_file")
    fi


    # ========================================================
    # BEFORE / AFTER CHECK
    # ========================================================

    echo
    echo "============================================================"
    echo " CFK RESOURCE RESULT"
    echo "============================================================"
    echo " Resource         : $resource_type"
    echo " Expected before  : $EXPECTED"
    echo " Collected after  : $COLLECTED"
    echo " Failed           : $FAILED"

    if [ "$EXPECTED" -eq "$COLLECTED" ]; then

        STATUS="OK"

        echo " Status           : OK - COUNTS MATCH"

    else

        STATUS="MISMATCH"

        MISSING=$((EXPECTED - COLLECTED))

        echo " Status           : WARNING - COUNTS DO NOT MATCH"
        echo " Missing          : $MISSING"
    fi

    echo "============================================================"

    {
        echo "ResourceType=$resource_type"
        echo "Expected=$EXPECTED"
        echo "Collected=$COLLECTED"
        echo "Failed=$FAILED"
        echo "BatchSize=$CR_BATCH_SIZE"
        echo "Status=$STATUS"
    } > "$summary_file"

    if [ "$EXPECTED" -ne "$COLLECTED" ]; then
        return 1
    fi

    return 0
}


# ============================================================
# COLLECT ALL CFK TYPES
#
# IMPORTANT:
#
# CR TYPES ARE SEQUENTIAL.
#
# Within each CR type:
# up to CR_BATCH_SIZE objects run in background.
#
# This avoids:
#
# 2 types x 50 = 100 requests
#
# and keeps it closer to:
#
# 1 type x 50 = 50 requests
# ============================================================

collect_all_cfk_resources() {

    overall_failed=0

    while IFS= read -r resource_type; do

        [ -z "$resource_type" ] && continue

        collect_cfk_type "$resource_type" || {
            overall_failed=1
        }

    done < cfk-resource-types.txt


    # ========================================================
    # MASTER SUMMARY
    # ========================================================

    echo
    echo "=========================================================================="
    echo " CFK MASTER SUMMARY"
    echo "=========================================================================="

    printf "%-55s %-10s %-10s %-10s %-12s\n" \
        "RESOURCE" \
        "EXPECTED" \
        "COLLECTED" \
        "FAILED" \
        "STATUS"

    printf "%-55s %-10s %-10s %-10s %-12s\n" \
        "--------" \
        "--------" \
        "---------" \
        "------" \
        "------"


    TOTAL_EXPECTED=0
    TOTAL_COLLECTED=0
    TOTAL_FAILED=0


    while IFS= read -r resource_type; do

        [ -z "$resource_type" ] && continue

        safe_type=$(echo "$resource_type" | tr '/.' '__')

        summary="cfk-summaries/${safe_type}-summary.txt"


        if [ ! -f "$summary" ]; then

            printf "%-55s %-10s %-10s %-10s %-12s\n" \
                "$resource_type" \
                "?" \
                "?" \
                "?" \
                "NO_SUMMARY"

            overall_failed=1

            continue
        fi


        EXPECTED=$(grep "^Expected=" "$summary" | cut -d= -f2-)

        COLLECTED=$(grep "^Collected=" "$summary" | cut -d= -f2-)

        FAILED=$(grep "^Failed=" "$summary" | cut -d= -f2-)

        STATUS=$(grep "^Status=" "$summary" | cut -d= -f2-)


        EXPECTED=${EXPECTED:-0}
        COLLECTED=${COLLECTED:-0}
        FAILED=${FAILED:-0}
        STATUS=${STATUS:-UNKNOWN}


        printf "%-55s %-10s %-10s %-10s %-12s\n" \
            "$resource_type" \
            "$EXPECTED" \
            "$COLLECTED" \
            "$FAILED" \
            "$STATUS"


        TOTAL_EXPECTED=$((TOTAL_EXPECTED + EXPECTED))

        TOTAL_COLLECTED=$((TOTAL_COLLECTED + COLLECTED))

        TOTAL_FAILED=$((TOTAL_FAILED + FAILED))


        if [ "$STATUS" != "OK" ]; then
            overall_failed=1
        fi

    done < cfk-resource-types.txt


    echo
    echo "------------------------------------------------------------"
    echo "TOTAL EXPECTED  : $TOTAL_EXPECTED"
    echo "TOTAL COLLECTED : $TOTAL_COLLECTED"
    echo "TOTAL FAILED    : $TOTAL_FAILED"
    echo "------------------------------------------------------------"


    {
        echo "TotalExpected=$TOTAL_EXPECTED"
        echo "TotalCollected=$TOTAL_COLLECTED"
        echo "TotalFailed=$TOTAL_FAILED"
    } > cfk-master-summary.txt


    if [ "$TOTAL_EXPECTED" -eq "$TOTAL_COLLECTED" ] && \
       [ "$overall_failed" -eq 0 ]; then

        echo
        echo "CFK STATUS: ALL COUNTS MATCH"

        return 0

    else

        echo
        echo "CFK STATUS: COLLECTION INCOMPLETE"

        return 1
    fi
}


# ============================================================
# PRE-COLLECTION CFK INVENTORY
# ============================================================

if ! prepare_cfk_lists; then

    echo
    echo "[FATAL] Unable to create initial CFK inventory."

    exit 1
fi


# ============================================================
# START TOP-LEVEL COLLECTORS IN PARALLEL
# ============================================================

echo
echo "============================================================"
echo " STARTING TOP-LEVEL COLLECTORS IN PARALLEL"
echo "============================================================"
echo


collect_pods &
PID_PODS=$!


collect_deployments &
PID_DEPLOYMENTS=$!


collect_events &
PID_EVENTS=$!


collect_logs &
PID_LOGS=$!


collect_statefulsets &
PID_STATEFULSETS=$!


collect_configmaps &
PID_CONFIGMAPS=$!


collect_all_cfk_resources &
PID_CFK=$!


echo "Top-level collector PIDs:"
echo
echo " Pods          : $PID_PODS"
echo " Deployments   : $PID_DEPLOYMENTS"
echo " Events        : $PID_EVENTS"
echo " Logs          : $PID_LOGS"
echo " StatefulSets  : $PID_STATEFULSETS"
echo " ConfigMaps    : $PID_CONFIGMAPS"
echo " ALL CFK CRs   : $PID_CFK"
echo


# ============================================================
# WAIT FOR TOP LEVEL
# ============================================================

failed=0


wait "$PID_PODS" || {

    echo "[ERROR] Pods collection failed"

    failed=1
}


wait "$PID_DEPLOYMENTS" || {

    echo "[ERROR] Deployments collection failed"

    failed=1
}


wait "$PID_EVENTS" || {

    echo "[ERROR] Events collection failed"

    failed=1
}


wait "$PID_LOGS" || {

    echo "[ERROR] Logs collection failed"

    failed=1
}


wait "$PID_STATEFULSETS" || {

    echo "[ERROR] StatefulSets collection failed"

    failed=1
}


wait "$PID_CONFIGMAPS" || {

    echo "[ERROR] ConfigMaps collection failed"

    failed=1
}


wait "$PID_CFK" || {

    echo "[ERROR] CFK collection incomplete"

    failed=1
}


# ============================================================
# FINAL SUMMARY
# ============================================================

echo
echo
echo "============================================================"
echo " FINAL COLLECTION SUMMARY"
echo "============================================================"


if [ "$failed" -eq 0 ]; then

    echo "Overall status : SUCCESS"

else

    echo "Overall status : COMPLETED WITH ERRORS"
fi


echo
echo "Namespace:"
echo "$namespace"


echo
echo "Output directory:"
echo "$(pwd)"


echo
echo "Configuration:"
echo " Pod logs batch : $LOG_BATCH_SIZE"
echo " CFK CR batch   : $CR_BATCH_SIZE"
echo " CFK CR types   : sequential"
echo " Retry attempts : $MAX_RETRIES"


if [ -f cfk-master-summary.txt ]; then

    echo
    echo "CFK totals:"

    cat cfk-master-summary.txt
fi


echo
echo "============================================================"
