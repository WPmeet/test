{{- define "cfk.connector.source.connection" -}}
{{- $root := .root -}}
{{- $connectorProvision := .connectorConfigs | default dict -}}
{{- $connectorProvisionConfigs := get $connectorProvision "configs" | default dict -}}

{{- if and
    (hasKey $root.Values.cfk.connector "source")
    (hasKey $root.Values.cfk.connector.source "connection")
-}}

    {{- $connectionConfigs := deepCopy
        ($root.Values.cfk.connector.source.connection | default dict) -}}

    {{- $connectorClass := $root.Values.cfk.connectorClass | default "" -}}

    {{/*
    MongoDB:
    Override the default connection.uri using the database from the
    current connector's provision.configs.
    */}}
    {{- if hasSuffix "MongoSourceConnector" $connectorClass -}}

        {{- $database := required
            "provision.configs.database is required for MongoSourceConnector"
            (get $connectorProvisionConfigs "database")
        -}}

        {{- $connectionUri := printf
            "${file:/vault/secrets/connector/mongodb/mongodb-connection-uri:%s}"
            $database
        -}}

        {{- $_ := set $connectionConfigs "connection.uri" $connectionUri -}}

    {{- end -}}

    {{- toYaml $connectionConfigs | nindent 4 -}}

{{- end -}}
{{- end -}}


{{/*
Shared connection configuration
*/}}
{{- define "cfk.connector.shared.connection" -}}
{{- $root := .root -}}
{{- $connectorClass := .connectorClass | default "" -}}

{{- if hasSuffix "CloudPubSubSinkConnector" $connectorClass -}}

    {{- $connectionConfig := deepCopy
        ($root.Values.cfk.connector.sink.connection.configs | default dict)
    -}}

    {{- $commonConfig := deepCopy
        ($root.Values.cfk.connector.shared.connection.configs | default dict)
    -}}

    {{- $_ := mergeOverwrite $connectionConfig $commonConfig -}}

    {{- toYaml $connectionConfig | nindent 4 -}}

{{- end -}}
{{- end -}}

cfk:
  connector:
    connectorClass: com.google.pubsub.kafka.sink.CloudPubSubSinkConnector

    sink:
      connection:
        configs:
          cps.project: hsbc-8578861-pd1-dev
          cps.topic: pdp_wda_us_statement_sit_input_topic
          cps.endpoint: googleapis-dev.gcp.cloud.uk.hsbc:3128

          gcp.credentials.file.path: /vault/secrets/connector/pubsub/pubsub-api-creds.json

          metadata.publish: "true"
          headers.publish: "true"
          orderingKeySource: key

          maxBufferSize: "100"
          maxBufferBytes: "9500000"
          maxOutstandingMessages: "1000"
          maxOutstandingRequestBytes: "104857600"
          maxDelayThresholdMs: "100"
          maxRequestTimeoutMs: "10000"
          maxTotalTimeoutMs: "60000"
          maxShutdownTimeoutMs: "60000"

      consumer:
        configs:
          consumer.override.security.protocol: SSL

          consumer.override.ssl.keystore.location: /vault/secrets/connector/keystore.jks

          consumer.override.ssl.keystore.password: '${file:/vault/secrets/connector/jksPassword.txt:jksPassword}'

          consumer.override.ssl.truststore.location: /vault/secrets/connector/truststore.jks

          consumer.override.ssl.truststore.password: '${file:/vault/secrets/connector/jksPassword.txt:jksPassword}'

          consumer.override.max.poll.interval.ms: "300000"
