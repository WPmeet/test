#!/bin/bash

set -u
set -o pipefail


# ============================================================
# CONFIGURATION
# ============================================================

namespace="cto-eep-obs-prod-uk"

# Pod logs:
# 4 pods started in background together
LOG_BATCH_SIZE=4

# CFK objects:
# 50 objects started in background together.
# Change to 25 / 50 / 100 as required.
CR_BATCH_SIZE=50

# How many CFK resource TYPES can be processed together.
# Example:
# KafkaTopics + ConfluentRoleBindings simultaneously.
CFK_TYPES_IN_PARALLEL=2

# Retry an individual failed CFK kubectl GET
MAX_RETRIES=3

# Show background process status every N seconds
STATUS_INTERVAL=2


# Optional namespace:
#
# ./support-bundle.sh my-namespace
#
if [ -n "${1:-}" ]; then
    namespace="$1"
fi


# ============================================================
# OUTPUT DIRECTORY
# ============================================================

echo "============================================================"
echo " Kubernetes / CFK Support Bundle"
echo "============================================================"
echo " Namespace               : $namespace"
echo " Log batch size          : $LOG_BATCH_SIZE"
echo " CFK object batch size   : $CR_BATCH_SIZE"
echo " CFK types in parallel   : $CFK_TYPES_IN_PARALLEL"
echo " Retry attempts          : $MAX_RETRIES"
echo " PID status interval     : ${STATUS_INTERVAL}s"
echo "============================================================"


output_dir="./k8s-info-${namespace}-$(date +%Y%m%d-%H%M%S)"

mkdir -p "$output_dir"
cd "$output_dir" || exit 1


mkdir -p logs
mkdir -p deployments
mkdir -p statefulsets
mkdir -p configmaps

mkdir -p cfk-resources
mkdir -p cfk-lists
mkdir -p cfk-summaries


echo
echo "Output directory:"
echo "$(pwd)"
echo


# ============================================================
# GENERIC PID WAIT / MONITOR FUNCTION
#
# Usage:
#
# wait_for_pid_batch "NAME" pid1 pid2 pid3 ...
#
# It:
#   - keeps checking running jobs
#   - shows number still running
#   - waits until all have completed
#   - waits/reaps every PID
#   - checks return codes
# ============================================================

wait_for_pid_batch() {

    batch_name="$1"
    shift

    pids="$@"

    total=0

    for pid in $pids; do
        total=$((total + 1))
    done


    if [ "$total" -eq 0 ]; then
        return 0
    fi


    echo
    echo "------------------------------------------------------------"
    echo "[$batch_name] Tracking $total background processes"
    echo "[$batch_name] PIDs: $pids"
    echo "------------------------------------------------------------"


    while true; do

        running_jobs=$(jobs -pr 2>/dev/null | wc -l | tr -d ' ')

        echo "[$batch_name] Total=$total  Still-running=$running_jobs"

        if [ "$running_jobs" -eq 0 ]; then
            break
        fi

        sleep "$STATUS_INTERVAL"

    done


    failed_jobs=0


    for pid in $pids; do

        wait "$pid"
        rc=$?

        if [ "$rc" -eq 0 ]; then

            echo "[$batch_name] PID $pid -> OK"

        else

            echo "[$batch_name] PID $pid -> FAILED rc=$rc"

            failed_jobs=$((failed_jobs + 1))
        fi

    done


    echo "[$batch_name] All background processes finished"
    echo "[$batch_name] Failed processes: $failed_jobs"
    echo


    if [ "$failed_jobs" -gt 0 ]; then
        return 1
    fi

    return 0
}


# ============================================================
# POD INFORMATION
# ============================================================

collect_pods() {

    echo "[PODS] Starting..."

    kubectl get pods \
        -n "$namespace" \
        -o wide \
        > pods.txt 2>&1

    rc=$?

    echo "[PODS] Finished rc=$rc"

    return "$rc"
}


# ============================================================
# EVENTS
# ============================================================

collect_events() {

    echo "[EVENTS] Starting..."

    kubectl get events \
        -n "$namespace" \
        --sort-by=.metadata.creationTimestamp \
        > events.txt 2>&1

    rc=$?

    echo "[EVENTS] Finished rc=$rc"

    return "$rc"
}


# ============================================================
# DEPLOYMENTS
# ============================================================

collect_deployments() {

    echo "[DEPLOYMENTS] Starting..."


    if ! kubectl get deployments \
        -n "$namespace" \
        --no-headers \
        -o custom-columns=":metadata.name" \
        > deployment-list.txt 2>deployment-list-error.txt; then

        echo "[DEPLOYMENTS] Unable to retrieve deployment list"

        return 1
    fi


    EXPECTED=$(grep -cve '^[[:space:]]*$' deployment-list.txt)

    echo "[DEPLOYMENTS] Expected: $EXPECTED"


    pids=""
    batch_count=0
    batch_number=1


    while IFS= read -r deployment; do

        [ -z "$deployment" ] && continue


        kubectl get deployment "$deployment" \
            -n "$namespace" \
            -o yaml \
            > "deployments/${deployment}.yaml" 2>&1 &


        pid=$!

        pids="$pids $pid"

        echo "[DEPLOYMENTS] $deployment -> PID $pid"

        batch_count=$((batch_count + 1))


        if [ "$batch_count" -ge "$CR_BATCH_SIZE" ]; then

            wait_for_pid_batch \
                "DEPLOYMENTS-BATCH-$batch_number" \
                $pids || true

            pids=""
            batch_count=0

            batch_number=$((batch_number + 1))
        fi


    done < deployment-list.txt


    if [ "$batch_count" -gt 0 ]; then

        wait_for_pid_batch \
            "DEPLOYMENTS-BATCH-$batch_number" \
            $pids || true

    fi


    COLLECTED=$(find deployments \
        -type f \
        -name "*.yaml" \
        | wc -l | tr -d ' ')


    echo "[DEPLOYMENTS] Expected=$EXPECTED Collected=$COLLECTED"


    if [ "$EXPECTED" -ne "$COLLECTED" ]; then
        return 1
    fi


    return 0
}


