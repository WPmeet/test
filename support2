#!/bin/bash

set -u
set -o pipefail

# ============================================================
# CONFIGURATION
# ============================================================

namespace="cto-eep-obs-prod-uk"

# Pod logs:
# 4 pod log commands launched together
LOG_BATCH_SIZE=4

# CFK objects:
# 50 objects launched together for each CR type
# Change to 25 / 50 / 100 if required
CR_BATCH_SIZE=50

# Retry failed CFK object GETs
MAX_RETRIES=3

# PID status update interval
STATUS_INTERVAL=2

# Optional namespace argument
# Example:
# ./support-bundle.sh another-namespace
if [ -n "${1:-}" ]; then
    namespace="$1"
fi


# ============================================================
# OUTPUT DIRECTORY
# ============================================================

echo "============================================================"
echo " Kubernetes / CFK Support Bundle"
echo "============================================================"
echo " Namespace          : $namespace"
echo " Log batch size     : $LOG_BATCH_SIZE"
echo " CFK CR batch size  : $CR_BATCH_SIZE"
echo " Retry attempts     : $MAX_RETRIES"
echo " Status interval    : ${STATUS_INTERVAL}s"
echo "============================================================"

output_dir="./k8s-info-${namespace}-$(date +%Y%m%d-%H%M%S)"

mkdir -p "$output_dir"
cd "$output_dir" || exit 1

mkdir -p logs
mkdir -p deployments
mkdir -p statefulsets
mkdir -p configmaps
mkdir -p cfk-resources
mkdir -p cfk-lists
mkdir -p cfk-summaries

echo
echo "Output directory: $(pwd)"
echo


# ============================================================
# WAIT FOR A SPECIFIC PID BATCH
#
# IMPORTANT:
# This checks ONLY the PIDs passed into this function.
#
# Example output:
#
# Total=50 Completed=10 Running=40
# Total=50 Completed=39 Running=11
# Total=50 Completed=50 Running=0
# ============================================================

wait_for_pid_batch() {

    batch_name="$1"
    shift

    pids="$*"

    total=0

    for pid in $pids; do
        total=$((total + 1))
    done

    if [ "$total" -eq 0 ]; then
        return 0
    fi

    echo
    echo "------------------------------------------------------------"
    echo "[$batch_name] Started $total background processes"
    echo "------------------------------------------------------------"

    while true; do

        running=0
        completed=0

        for pid in $pids; do

            if kill -0 "$pid" 2>/dev/null; then
                running=$((running + 1))
            else
                completed=$((completed + 1))
            fi

        done

        echo "[$batch_name] Total=$total Completed=$completed Running=$running"

        if [ "$running" -eq 0 ]; then
            break
        fi

        sleep "$STATUS_INTERVAL"

    done

    failed=0

    for pid in $pids; do

        wait "$pid"
        rc=$?

        if [ "$rc" -ne 0 ]; then
            failed=$((failed + 1))
        fi

    done

    echo "[$batch_name] Finished=$total Failed=$failed"
    echo

    if [ "$failed" -gt 0 ]; then
        return 1
    fi

    return 0
}


# ============================================================
# POD INFORMATION
# ============================================================

collect_pods() {

    echo "[PODS] Starting..."

    kubectl get pods \
        -n "$namespace" \
        -o wide \
        > pods.txt 2>&1

    rc=$?

    echo "[PODS] Finished rc=$rc"

    return "$rc"
}


# ============================================================
# EVENTS
# ============================================================

collect_events() {

    echo "[EVENTS] Starting..."

    kubectl get events \
        -n "$namespace" \
        --sort-by=.metadata.creationTimestamp \
        > events.txt 2>&1

    rc=$?

    echo "[EVENTS] Finished rc=$rc"

    return "$rc"
}


# ============================================================
# DEPLOYMENTS
# ============================================================

collect_deployments() {

    echo "[DEPLOYMENTS] Starting..."

    if ! kubectl get deployments \
        -n "$namespace" \
        --no-headers \
        -o custom-columns=":metadata.name" \
        > deployment-list.txt \
        2> deployment-list-error.txt; then

        echo "[DEPLOYMENTS] Failed to retrieve list"
        return 1
    fi

    EXPECTED=$(grep -cve '^[[:space:]]*$' deployment-list.txt)

    echo "[DEPLOYMENTS] Expected: $EXPECTED"

    pids=""
    batch_count=0
    batch_number=1

    while IFS= read -r deployment; do

        [ -z "$deployment" ] && continue

        kubectl get deployment "$deployment" \
            -n "$namespace" \
            -o yaml \
            > "deployments/${deployment}.yaml" 2>&1 &

        pid=$!

        pids="$pids $pid"

        echo "[DEPLOYMENTS] $deployment -> PID $pid"

        batch_count=$((batch_count + 1))

        if [ "$batch_count" -ge "$CR_BATCH_SIZE" ]; then

            wait_for_pid_batch \
                "DEPLOYMENTS-BATCH-$batch_number" \
                $pids || true

            pids=""
            batch_count=0
            batch_number=$((batch_number + 1))
        fi

    done < deployment-list.txt

    if [ "$batch_count" -gt 0 ]; then

        wait_for_pid_batch \
            "DEPLOYMENTS-BATCH-$batch_number" \
            $pids || true
    fi

    COLLECTED=$(find deployments \
        -type f \
        -name "*.yaml" \
        | wc -l | tr -d ' ')

    echo "[DEPLOYMENTS] Expected=$EXPECTED Collected=$COLLECTED"

    if [ "$EXPECTED" -ne "$COLLECTED" ]; then
        return 1
    fi

    return 0
}


