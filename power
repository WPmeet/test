# ===== EDIT ONLY THIS URL =====
$url = 'http://cto-eep-obs-prod-uk-azb4001-broker6.uk.hsbc:7777/jolokia/'

# One POST request to Jolokia
$body = @'
[
  {"type":"read","mbean":"kafka.server:name=BrokerState,type=KafkaServer","attribute":"Value"},

  {"type":"read","mbean":"java.lang:type=Memory","attribute":"HeapMemoryUsage"},
  {"type":"read","mbean":"java.lang:type=OperatingSystem","attribute":["ProcessCpuLoad","SystemCpuLoad"]},

  {"type":"read","mbean":"kafka.server:name=UnderReplicatedPartitions,type=ReplicaManager","attribute":"Value"},
  {"type":"read","mbean":"kafka.server:name=UnderMinIsrPartitionCount,type=ReplicaManager","attribute":"Value"},
  {"type":"read","mbean":"kafka.server:name=OfflineReplicaCount,type=ReplicaManager","attribute":"Value"},
  {"type":"read","mbean":"kafka.server:name=PartitionCount,type=ReplicaManager","attribute":"Value"},
  {"type":"read","mbean":"kafka.server:name=LeaderCount,type=ReplicaManager","attribute":"Value"},
  {"type":"read","mbean":"kafka.server:name=ReassigningPartitions,type=ReplicaManager","attribute":"Value"},

  {"type":"read","mbean":"kafka.controller:name=ActiveControllerCount,type=KafkaController","attribute":"Value"},
  {"type":"read","mbean":"kafka.controller:name=OfflinePartitionsCount,type=KafkaController","attribute":"Value"}
]
'@

while ($true) {
    Clear-Host
    Write-Host "===== $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') =====" -ForegroundColor Cyan

    try {
        $r = Invoke-RestMethod `
            -Uri $url `
            -Method POST `
            -ContentType 'application/json' `
            -Body $body `
            -TimeoutSec 15 `
            -ErrorAction Stop

        $r | ForEach-Object {
            $name = $_.request.mbean

            if ($_.status -eq 200) {
                $value = $_.value

                # Jolokia gives {"Value":n} for single-value Kafka MBeans
                if ($null -ne $value.Value) {
                    $value = $value.Value
                }
                elseif ($null -ne $value.HeapMemoryUsage) {
                    $usedGiB = [math]::Round($value.HeapMemoryUsage.used / 1GB, 2)
                    $maxGiB  = [math]::Round($value.HeapMemoryUsage.max / 1GB, 2)
                    $pct     = [math]::Round(($value.HeapMemoryUsage.used / $value.HeapMemoryUsage.max) * 100, 1)
                    $value   = "used=$usedGiB GiB / max=$maxGiB GiB ($pct%)"
                }
                elseif ($null -ne $value.ProcessCpuLoad) {
                    $procCpu = [math]::Round($value.ProcessCpuLoad * 100, 1)
                    $sysCpu  = [math]::Round($value.SystemCpuLoad * 100, 1)
                    $value   = "process=$procCpu% system=$sysCpu%"
                }

                Write-Host "$name : $value"
            }
            else {
                Write-Host "$name : N/A | status=$($_.status) | $($_.error)" -ForegroundColor DarkYellow
            }
        }
    }
    catch {
        Write-Host "JOLOKIA REQUEST FAILED: $($_.Exception.Message)" -ForegroundColor Red
    }

    Start-Sleep -Seconds 10
}
