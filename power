function Get-JmxValue {
    param(
        [array]$Response,
        [string]$MBean
    )

    $parts = $MBean -split ':', 2
    $domain = $parts[0]

    $keys = @{}
    if ($parts.Count -eq 2) {
        ($parts[1] -split ',') | ForEach-Object {
            $kv = $_ -split '=', 2
            if ($kv.Count -eq 2) {
                $keys[$kv[0]] = $kv[1]
            }
        }
    }

    $item = $Response | Where-Object {
        if ($_.status -ne 200) { return $false }

        $actualParts = $_.request.mbean -split ':', 2
        if ($actualParts[0] -ne $domain) { return $false }

        $actualKeys = @{}
        if ($actualParts.Count -eq 2) {
            ($actualParts[1] -split ',') | ForEach-Object {
                $kv = $_ -split '=', 2
                if ($kv.Count -eq 2) {
                    $actualKeys[$kv[0]] = $kv[1]
                }
            }
        }

        foreach ($key in $keys.Keys) {
            if ($actualKeys[$key] -ne $keys[$key]) {
                return $false
            }
        }

        return $true
    } | Select-Object -First 1

    if ($null -eq $item) {
        return 'N/A'
    }

    if ($item.value -is [System.Collections.IDictionary] -and
        $item.value.Contains('Value')) {
        return $item.value.Value
    }

    return $item.value
}
