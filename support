#!/bin/bash

set -u
set -o pipefail


# ============================================================
# CONFIGURATION
# ============================================================

namespace="cto-eep-obs-prod-uk"

# Logs:
# 4 pod log commands together, then wait
LOG_BATCH_SIZE=4

# CFK CRs:
# 50 objects together, track PIDs, wait, then next 50
#
# Change to:
# CR_BATCH_SIZE=25
# CR_BATCH_SIZE=50
# CR_BATCH_SIZE=100
#
CR_BATCH_SIZE=50

MAX_RETRIES=3
STATUS_INTERVAL=2


# Optional namespace:
#
# ./support-bundle.sh another-namespace
#
if [ -n "${1:-}" ]; then
    namespace="$1"
fi


# ============================================================
# OUTPUT DIRECTORY
# ============================================================

output_dir="./k8s-info-${namespace}-$(date +%Y%m%d-%H%M%S)"

mkdir -p "$output_dir"
cd "$output_dir" || exit 1


mkdir -p logs
mkdir -p cfk
mkdir -p cfk/lists
mkdir -p cfk/resources
mkdir -p cfk/failed
mkdir -p cfk/summary


echo "============================================================"
echo " Kubernetes / CFK Support Bundle"
echo "============================================================"
echo "Namespace      : $namespace"
echo "Log batch      : $LOG_BATCH_SIZE"
echo "CFK batch      : $CR_BATCH_SIZE"
echo "Retries        : $MAX_RETRIES"
echo "Output         : $(pwd)"
echo "============================================================"
echo


# ============================================================
# WAIT FOR EXACT PIDS PASSED TO THIS FUNCTION
# ============================================================

wait_for_batch() {

    batch_name="$1"
    shift

    pids="$*"

    total=0

    for pid in $pids; do
        total=$((total + 1))
    done


    if [ "$total" -eq 0 ]; then
        return 0
    fi


    echo
    echo "------------------------------------------------------------"
    echo "[$batch_name] Started $total background processes"
    echo "------------------------------------------------------------"


    while true; do

        running=0
        completed=0

        for pid in $pids; do

            if kill -0 "$pid" 2>/dev/null; then

                running=$((running + 1))

            else

                completed=$((completed + 1))

            fi

        done


        echo "[$batch_name] Total=$total Completed=$completed Running=$running"


        if [ "$running" -eq 0 ]; then
            break
        fi


        sleep "$STATUS_INTERVAL"

    done


    failed=0


    for pid in $pids; do

        wait "$pid"

        rc=$?


        if [ "$rc" -ne 0 ]; then
            failed=$((failed + 1))
        fi

    done


    echo "[$batch_name] Finished=$total Failed=$failed"
    echo


    if [ "$failed" -gt 0 ]; then
        return 1
    fi


    return 0
}


# ============================================================
# POD INFORMATION
# ============================================================

collect_pods() {

    echo "[PODS] Starting..."

    kubectl get pods \
        -n "$namespace" \
        -o wide \
        > pods.txt 2>&1

    rc=$?

    echo "[PODS] Finished rc=$rc"

    return "$rc"
}


# ============================================================
# DEPLOYMENTS
#
# Get ALL deployments in one call.
# ============================================================

collect_deployments() {

    echo "[DEPLOYMENTS] Starting..."

    kubectl get deployments \
        -n "$namespace" \
        -o yaml \
        > deployments.yaml 2>&1

    rc=$?

    echo "[DEPLOYMENTS] Finished rc=$rc"

    return "$rc"
}


# ============================================================
# STATEFULSETS
#
# Get ALL StatefulSets in one call.
# ============================================================

collect_statefulsets() {

    echo "[STATEFULSETS] Starting..."

    kubectl get statefulsets \
        -n "$namespace" \
        -o yaml \
        > statefulsets.yaml 2>&1

    rc=$?

    echo "[STATEFULSETS] Finished rc=$rc"

    return "$rc"
}


# ============================================================
# CONFIGMAPS
#
# Get ALL ConfigMaps.
# ============================================================

collect_configmaps() {

    echo "[CONFIGMAPS] Starting..."

    kubectl get configmaps \
        -n "$namespace" \
        -o yaml \
        > configmaps.yaml 2>&1

    rc=$?

    echo "[CONFIGMAPS] Finished rc=$rc"

    return "$rc"
}


# ============================================================
# EVENTS
# ============================================================

collect_events() {

    echo "[EVENTS] Starting..."

    kubectl get events \
        -n "$namespace" \
        --sort-by=.metadata.creationTimestamp \
        > events.txt 2>&1

    rc=$?

    echo "[EVENTS] Finished rc=$rc"

    return "$rc"
}


# ============================================================
# POD LOGS
#
# Get all pod names.
# Run 4 logs in background.
# Track exact PIDs.
# Wait.
# Then next 4.
# ============================================================

collect_logs() {

    echo "[LOGS] Starting..."


    if ! kubectl get pods \
        -n "$namespace" \
        -o name \
        > pod-list.txt \
        2> pod-list-error.txt; then

        echo "[LOGS] ERROR retrieving pod list"

        return 1
    fi


    EXPECTED=$(grep -cve '^[[:space:]]*$' pod-list.txt)


    echo "[LOGS] Pods discovered: $EXPECTED"


    pids=""
    batch_count=0
    batch_number=1


    while IFS= read -r pod_ref; do

        [ -z "$pod_ref" ] && continue


        # pod_ref looks like:
        #
        # pod/my-pod-name
        #

        pod_name=${pod_ref#pod/}


        echo "[LOGS] $pod_name"


        kubectl logs "$pod_ref" \
            -n "$namespace" \
            --all-containers=true \
            > "logs/${pod_name}.log" 2>&1 &


        pid=$!

        pids="$pids $pid"

        batch_count=$((batch_count + 1))


        if [ "$batch_count" -ge "$LOG_BATCH_SIZE" ]; then


            wait_for_batch \
                "LOG-BATCH-$batch_number" \
                $pids || true


            pids=""
            batch_count=0
            batch_number=$((batch_number + 1))

        fi


    done < pod-list.txt


    # Final partial batch

    if [ "$batch_count" -gt 0 ]; then

        wait_for_batch \
            "LOG-BATCH-$batch_number" \
            $pids || true

    fi


    COLLECTED=$(find logs \
        -type f \
        -name "*.log" \
        | wc -l \
        | tr -d ' ')


    echo
    echo "[LOGS] Expected=$EXPECTED"
    echo "[LOGS] Files=$COLLECTED"
    echo


    return 0
}


# ============================================================
# DISCOVER CFK RESOURCE TYPES
#
# This ONLY discovers CR types belonging to:
#
# platform.confluent.io
#
# Example:
#
# kafkatopics.platform.confluent.io
# confluentrolebindings.platform.confluent.io
# connectors.platform.confluent.io
# kafkas.platform.confluent.io
# connects.platform.confluent.io
# etc.
# ============================================================

discover_cfk_types() {

    echo
    echo "============================================================"
    echo " Discovering CFK resource types"
    echo "============================================================"


    kubectl api-resources \
        --api-group=platform.confluent.io \
        --namespaced=true \
        --verbs=list \
        -o name \
        > cfk/resource-types.txt \
        2> cfk/resource-types-error.txt


    if [ ! -s cfk/resource-types.txt ]; then

        echo "[CFK] ERROR: No CFK resource types discovered"

        return 1
    fi


    TYPE_COUNT=$(grep -cve '^[[:space:]]*$' cfk/resource-types.txt)


    echo "[CFK] Resource types discovered: $TYPE_COUNT"


    cat cfk/resource-types.txt


    echo "============================================================"
    echo


    return 0
}


# ============================================================
# BUILD INITIAL CFK INVENTORY
#
# IMPORTANT:
#
# For EACH resource type:
#
# kubectl get <type> -o name
#
# The COMPLETE reference is preserved.
#
# Example:
#
# kafkatopic.platform.confluent.io/topic-one
# kafkatopic.platform.confluent.io/topic-two
#
# That avoids manually reconstructing resource/name.
# ============================================================

build_cfk_inventory() {

    echo
    echo "============================================================"
    echo " Building CFK inventory BEFORE collection"
    echo "============================================================"


    TOTAL_EXPECTED=0


    while IFS= read -r resource_type; do

        [ -z "$resource_type" ] && continue


        safe_type=$(echo "$resource_type" | tr '/.' '__')


        list_file="cfk/lists/${safe_type}.txt"

        error_file="cfk/lists/${safe_type}-error.txt"


        echo
        echo "[CFK] Listing $resource_type"


        if ! kubectl get "$resource_type" \
            -n "$namespace" \
            -o name \
            > "$list_file" \
            2> "$error_file"; then


            echo "[CFK] ERROR listing $resource_type"

            return 1

        fi


        EXPECTED=$(grep -cve '^[[:space:]]*$' "$list_file")


        echo "[CFK] $resource_type -> EXPECTED=$EXPECTED"


        TOTAL_EXPECTED=$((TOTAL_EXPECTED + EXPECTED))


        {
            echo "ResourceType=$resource_type"
            echo "Expected=$EXPECTED"
        } > "cfk/summary/${safe_type}-inventory.txt"


    done < cfk/resource-types.txt


    echo
    echo "============================================================"
    echo " CFK TOTAL EXPECTED BEFORE COLLECTION: $TOTAL_EXPECTED"
    echo "============================================================"
    echo


    echo "$TOTAL_EXPECTED" > cfk/total-expected.txt


    return 0
}


# ============================================================
# COLLECT ONE CFK OBJECT
#
# object_ref already contains:
#
# resource/name
#
# Example:
#
# kafkatopic.platform.confluent.io/my-topic
#
# So we simply:
#
# kubectl get "$object_ref"
# ============================================================

collect_one_cfk_object() {

    object_ref="$1"
    safe_type="$2"


    object_name=${object_ref#*/}


    output_dir="cfk/resources/${safe_type}"


    mkdir -p "$output_dir"


    tmp_file="${output_dir}/${object_name}.yaml.tmp"

    final_file="${output_dir}/${object_name}.yaml"


    attempt=1


    while [ "$attempt" -le "$MAX_RETRIES" ]; do


        if kubectl get "$object_ref" \
            -n "$namespace" \
            -o yaml \
            > "$tmp_file" \
            2>&1; then


            #
            # Basic sanity check.
            #
            # Only successful valid YAML becomes .yaml
            #

            if grep -q '^apiVersion:' "$tmp_file" && \
               grep -q '^kind:' "$tmp_file" && \
               grep -q '^metadata:' "$tmp_file"; then


                mv "$tmp_file" "$final_file"


                return 0

            fi

        fi


        rm -f "$tmp_file"


        echo "[CFK] Retry $attempt/$MAX_RETRIES : $object_ref"


        attempt=$((attempt + 1))


        sleep 2

    done


    echo "$object_ref" \
        >> "cfk/failed/${safe_type}.txt"


    echo "[CFK] FAILED : $object_ref"


    return 1
}


# ============================================================
# COLLECT ONE CFK RESOURCE TYPE
#
# Example CR_BATCH_SIZE=50:
#
# First 50:
#
# GET &
# GET &
# ...
# GET &
#
# save PIDs
# monitor PIDs
# wait
#
# Then next 50.
# ============================================================

collect_cfk_type() {

    resource_type="$1"


    safe_type=$(echo "$resource_type" | tr '/.' '__')


    list_file="cfk/lists/${safe_type}.txt"

    output_dir="cfk/resources/${safe_type}"

    failed_file="cfk/failed/${safe_type}.txt"

    summary_file="cfk/summary/${safe_type}.txt"


    mkdir -p "$output_dir"

    rm -f "$failed_file"


    EXPECTED=$(grep -cve '^[[:space:]]*$' "$list_file")


    echo
    echo "============================================================"
    echo " CFK RESOURCE TYPE"
    echo "============================================================"
    echo "Resource : $resource_type"
    echo "Expected : $EXPECTED"
    echo "Batch    : $CR_BATCH_SIZE"
    echo "============================================================"


    if [ "$EXPECTED" -eq 0 ]; then


        {
            echo "ResourceType=$resource_type"
            echo "Expected=0"
            echo "Collected=0"
            echo "Failed=0"
            echo "Status=OK"
        } > "$summary_file"


        return 0

    fi


    pids=""
    batch_count=0
    batch_number=1


    while IFS= read -r object_ref; do

        [ -z "$object_ref" ] && continue


        collect_one_cfk_object \
            "$object_ref" \
            "$safe_type" &


        pid=$!


        pids="$pids $pid"


        echo "[CFK][$resource_type] $object_ref -> PID $pid"


        batch_count=$((batch_count + 1))


        if [ "$batch_count" -ge "$CR_BATCH_SIZE" ]; then


            wait_for_batch \
                "CFK-${safe_type}-BATCH-$batch_number" \
                $pids || true


            pids=""

            batch_count=0

            batch_number=$((batch_number + 1))

        fi


    done < "$list_file"


    # Final partial batch

    if [ "$batch_count" -gt 0 ]; then


        wait_for_batch \
            "CFK-${safe_type}-BATCH-$batch_number" \
            $pids || true

    fi


    # ========================================================
    # COUNT SUCCESSFULLY DOWNLOADED YAML FILES
    # ========================================================

    COLLECTED=$(find "$output_dir" \
        -type f \
        -name "*.yaml" \
        | wc -l \
        | tr -d ' ')


    FAILED=0


    if [ -f "$failed_file" ]; then

        FAILED=$(grep -cve '^[[:space:]]*$' "$failed_file")

    fi


    # ========================================================
    # VALIDATION
    # ========================================================

    if [ "$EXPECTED" -eq "$COLLECTED" ]; then

        STATUS="OK"

    else

        STATUS="MISMATCH"

    fi


    echo
    echo "------------------------------------------------------------"
    echo "Resource         : $resource_type"
    echo "Expected before  : $EXPECTED"
    echo "Collected after  : $COLLECTED"
    echo "Failed           : $FAILED"
    echo "Status           : $STATUS"
    echo "------------------------------------------------------------"


    {
        echo "ResourceType=$resource_type"
        echo "Expected=$EXPECTED"
        echo "Collected=$COLLECTED"
        echo "Failed=$FAILED"
        echo "BatchSize=$CR_BATCH_SIZE"
        echo "Status=$STATUS"
    } > "$summary_file"


    if [ "$EXPECTED" -ne "$COLLECTED" ]; then

        return 1

    fi


    return 0
}


# ============================================================
# COLLECT ALL CFK CR TYPES
#
# CR types themselves are sequential.
#
# Within each type:
# CR_BATCH_SIZE objects are parallel.
#
# Example:
#
# KafkaTopics
#     50 parallel -> wait
#     50 parallel -> wait
#
# CFRBs
#     50 parallel -> wait
#
# Connectors
#     50 parallel -> wait
#
# etc.
# ============================================================

collect_all_cfk() {

    overall_failed=0


    while IFS= read -r resource_type; do

        [ -z "$resource_type" ] && continue


        collect_cfk_type "$resource_type" || {

            overall_failed=1

        }


    done < cfk/resource-types.txt


    # ========================================================
    # MASTER SUMMARY
    # ========================================================

    TOTAL_EXPECTED=0
    TOTAL_COLLECTED=0
    TOTAL_FAILED=0


    echo
    echo "=========================================================================="
    echo " CFK MASTER SUMMARY"
    echo "=========================================================================="

    printf "%-55s %-10s %-10s %-10s %-12s\n" \
        "RESOURCE" \
        "EXPECTED" \
        "COLLECTED" \
        "FAILED" \
        "STATUS"


    while IFS= read -r resource_type; do

        [ -z "$resource_type" ] && continue


        safe_type=$(echo "$resource_type" | tr '/.' '__')


        summary_file="cfk/summary/${safe_type}.txt"


        [ -f "$summary_file" ] || continue


        EXPECTED=$(grep '^Expected=' "$summary_file" | cut -d= -f2-)

        COLLECTED=$(grep '^Collected=' "$summary_file" | cut -d= -f2-)

        FAILED=$(grep '^Failed=' "$summary_file" | cut -d= -f2-)

        STATUS=$(grep '^Status=' "$summary_file" | cut -d= -f2-)


        printf "%-55s %-10s %-10s %-10s %-12s\n" \
            "$resource_type" \
            "$EXPECTED" \
            "$COLLECTED" \
            "$FAILED" \
            "$STATUS"


        TOTAL_EXPECTED=$((TOTAL_EXPECTED + EXPECTED))

        TOTAL_COLLECTED=$((TOTAL_COLLECTED + COLLECTED))

        TOTAL_FAILED=$((TOTAL_FAILED + FAILED))


    done < cfk/resource-types.txt


    echo
    echo "------------------------------------------------------------"
    echo "TOTAL EXPECTED  : $TOTAL_EXPECTED"
    echo "TOTAL COLLECTED : $TOTAL_COLLECTED"
    echo "TOTAL FAILED    : $TOTAL_FAILED"
    echo "------------------------------------------------------------"


    {
        echo "TotalExpected=$TOTAL_EXPECTED"
        echo "TotalCollected=$TOTAL_COLLECTED"
        echo "TotalFailed=$TOTAL_FAILED"
    } > cfk/master-summary.txt


    if [ "$TOTAL_EXPECTED" -ne "$TOTAL_COLLECTED" ]; then

        overall_failed=1

    fi


    return "$overall_failed"
}


# ============================================================
# STEP 1
# DISCOVER CFK RESOURCE TYPES
# ============================================================

discover_cfk_types || exit 1


# ============================================================
# STEP 2
# CREATE THE BEFORE-COLLECTION INVENTORY
#
# This gives us the authoritative expected counts before any
# parallel GET activity starts.
# ============================================================

build_cfk_inventory || exit 1


# ============================================================
# STEP 3
# START MAIN COLLECTIONS IN PARALLEL
# ============================================================

echo
echo "============================================================"
echo " Starting top-level collectors in parallel"
echo "============================================================"
echo


collect_pods &
PID_PODS=$!


collect_deployments &
PID_DEPLOYMENTS=$!


collect_statefulsets &
PID_STATEFULSETS=$!


collect_configmaps &
PID_CONFIGMAPS=$!


collect_events &
PID_EVENTS=$!


collect_logs &
PID_LOGS=$!


collect_all_cfk &
PID_CFK=$!


echo "Top-level PIDs:"
echo " Pods          : $PID_PODS"
echo " Deployments   : $PID_DEPLOYMENTS"
echo " StatefulSets  : $PID_STATEFULSETS"
echo " ConfigMaps    : $PID_CONFIGMAPS"
echo " Events        : $PID_EVENTS"
echo " Logs          : $PID_LOGS"
echo " CFK CRs       : $PID_CFK"
echo


# ============================================================
# STEP 4
# WAIT FOR EVERYTHING
# ============================================================

failed=0


wait "$PID_PODS" || failed=1

wait "$PID_DEPLOYMENTS" || failed=1

wait "$PID_STATEFULSETS" || failed=1

wait "$PID_CONFIGMAPS" || failed=1

wait "$PID_EVENTS" || failed=1

wait "$PID_LOGS" || failed=1

wait "$PID_CFK" || failed=1


# ============================================================
# FINAL
# ============================================================

echo
echo "============================================================"
echo " COLLECTION FINISHED"
echo "============================================================"


if [ "$failed" -eq 0 ]; then

    echo "STATUS : SUCCESS"

else

    echo "STATUS : COMPLETED WITH ERRORS"

fi


echo
echo "Output directory:"
echo "$(pwd)"


if [ -f cfk/master-summary.txt ]; then

    echo
    echo "CFK SUMMARY:"
    cat cfk/master-summary.txt

fi


echo "============================================================"
