#!/bin/bash

set -u
set -o pipefail

# ============================================================
# CONFIGURATION
# ============================================================

namespace="cto-eep-obs-prod-uk"

# Maximum number of kubectl log requests running at same time
MAX_PARALLEL_LOGS=4

# Optional namespace argument
# Example:
# ./support-bundle.sh another-namespace
if [ -n "${1:-}" ]; then
    namespace="$1"
fi

echo "============================================================"
echo " Collecting Kubernetes Information"
echo " Namespace: $namespace"
echo " Max parallel log collections: $MAX_PARALLEL_LOGS"
echo "============================================================"

# ============================================================
# CREATE OUTPUT DIRECTORY
# ============================================================

output_dir="./k8s-info-${namespace}-$(date +%Y%m%d-%H%M%S)"

mkdir -p "$output_dir"
cd "$output_dir" || exit 1

echo "Output directory: $(pwd)"
echo


# ============================================================
# POD INFORMATION
# ============================================================

collect_pods() {

    echo "[PODS] Starting..."

    kubectl get pods \
        -n "$namespace" \
        -o wide \
        > pods.txt 2>&1

    echo "[PODS] Finished"
}


# ============================================================
# DEPLOYMENTS
# ============================================================

collect_deployments() {

    echo "[DEPLOYMENTS] Starting..."

    kubectl get deployments \
        -n "$namespace" \
        -o yaml \
        > deployment.yaml 2>&1

    echo "[DEPLOYMENTS] Finished"
}


# ============================================================
# EVENTS
# ============================================================

collect_events() {

    echo "[EVENTS] Starting..."

    kubectl get events \
        -n "$namespace" \
        --sort-by=.metadata.creationTimestamp \
        > events.txt 2>&1

    echo "[EVENTS] Finished"
}


# ============================================================
# POD LOGS
#
# Maximum 4 kubectl logs commands run at the same time.
# ============================================================

collect_logs() {

    echo "[LOGS] Starting (maximum $MAX_PARALLEL_LOGS parallel)..."

    pods=$(kubectl get pods \
        -n "$namespace" \
        --no-headers \
        -o custom-columns=":metadata.name")

    running=0

    for pod in $pods; do

        echo "[LOGS] Starting collection for: $pod"

        kubectl logs "$pod" \
            -n "$namespace" \
            --all-containers=true \
            > "${pod}.log" 2>&1 &

        running=$((running + 1))

        # Once 4 are running, wait for this batch to finish
        if [ "$running" -ge "$MAX_PARALLEL_LOGS" ]; then

            echo "[LOGS] Waiting for current batch of $MAX_PARALLEL_LOGS..."

            wait

            running=0
        fi

    done

    # Wait for remaining 1-3 pods
    wait

    echo "[LOGS] Finished"
}


# ============================================================
# STATEFULSETS
# ============================================================

collect_statefulsets() {

    echo "[STATEFULSETS] Starting..."

    statefulsets=$(kubectl get sts \
        -n "$namespace" \
        --no-headers \
        -o custom-columns=":metadata.name")

    for sts in $statefulsets; do

        echo "[STATEFULSETS] Collecting: $sts"

        kubectl get sts "$sts" \
            -n "$namespace" \
            -o yaml \
            > "${sts}-statefulset.yaml" 2>&1

    done

    echo "[STATEFULSETS] Finished"
}


# ============================================================
# CONFLUENT PLATFORM CUSTOM RESOURCES
# ============================================================

collect_confluent_crs() {

    echo "[CFK CRs] Starting..."

    for cr in $(kubectl api-resources \
        --verbs=list \
        --namespaced=true \
        -o name 2>/dev/null | grep "platform.confluent.io"); do

        echo "[CFK CRs] Checking resource type: $cr"

        names=$(kubectl get "$cr" \
            -n "$namespace" \
            --no-headers \
            -o custom-columns=":metadata.name" \
            2>/dev/null)

        for name in $names; do

            safe_cr=$(echo "$cr" | tr '/' '_')

            echo "[CFK CRs] Collecting: $cr/$name"

            kubectl get "$cr" "$name" \
                -n "$namespace" \
                -o yaml \
                > "${safe_cr}-${name}.yaml" 2>&1

        done

    done

    echo "[CFK CRs] Finished"
}


# ============================================================
# SHARED CONFIGMAPS
# ============================================================

collect_configmaps() {

    echo "[CONFIGMAPS] Starting..."

    configmaps=$(kubectl get configmaps \
        -n "$namespace" \
        --no-headers \
        -o custom-columns=":metadata.name" \
        2>/dev/null | grep "shared-config" || true)

    for configmap in $configmaps; do

        echo "[CONFIGMAPS] Collecting: $configmap"

        kubectl get configmap "$configmap" \
            -n "$namespace" \
            -o yaml \
            > "${configmap}-configmap.yaml" 2>&1

    done

    echo "[CONFIGMAPS] Finished"
}


# ============================================================
# START ALL MAIN COLLECTORS IN PARALLEL
# ============================================================

echo
echo "============================================================"
echo " Starting collectors in parallel"
echo "============================================================"
echo

collect_pods &
PID_PODS=$!

collect_deployments &
PID_DEPLOYMENTS=$!

collect_events &
PID_EVENTS=$!

collect_logs &
PID_LOGS=$!

collect_statefulsets &
PID_STATEFULSETS=$!

collect_confluent_crs &
PID_CFK=$!

collect_configmaps &
PID_CONFIGMAPS=$!


echo
echo "Background collector PIDs:"
echo "  Pods         : $PID_PODS"
echo "  Deployments  : $PID_DEPLOYMENTS"
echo "  Events       : $PID_EVENTS"
echo "  Logs         : $PID_LOGS"
echo "  StatefulSets : $PID_STATEFULSETS"
echo "  CFK CRs      : $PID_CFK"
echo "  ConfigMaps   : $PID_CONFIGMAPS"
echo


# ============================================================
# WAIT FOR ALL MAIN COLLECTORS
# ============================================================

failed=0

wait "$PID_PODS" || {
    echo "[ERROR] Pods collection failed"
    failed=1
}

wait "$PID_DEPLOYMENTS" || {
    echo "[ERROR] Deployment collection failed"
    failed=1
}

wait "$PID_EVENTS" || {
    echo "[ERROR] Events collection failed"
    failed=1
}

wait "$PID_LOGS" || {
    echo "[ERROR] Pod logs collection failed"
    failed=1
}

wait "$PID_STATEFULSETS" || {
    echo "[ERROR] StatefulSet collection failed"
    failed=1
}

wait "$PID_CFK" || {
    echo "[ERROR] CFK CR collection failed"
    failed=1
}

wait "$PID_CONFIGMAPS" || {
    echo "[ERROR] ConfigMap collection failed"
    failed=1
}


# ============================================================
# COMPLETE
# ============================================================

echo
echo "============================================================"

if [ "$failed" -eq 0 ]; then
    echo " Collection completed successfully."
else
    echo " Collection completed with one or more errors."
fi

echo
echo " Files saved in:"
echo " $(pwd)"
echo
echo " Maximum parallel pod log requests: $MAX_PARALLEL_LOGS"

echo "============================================================"
